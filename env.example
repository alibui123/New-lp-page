# Retell — server only (used by /api/retell/web-call). Do not commit real keys.
RETELL_API_KEY=
RETELL_AGENT_ID=

# Static hosting (Hostinger, etc.): API routes are not in `dist/`. Use ONE of:
# A) Set before `npm run dist`: NEXT_PUBLIC_RETELL_TOKEN_URL=https://your-worker...workers.dev
# B) Easier: after upload, edit `voice-token-endpoint.json` on the server (same folder as index.html)
#    and set "tokenUrl" to your Worker URL — no rebuild. See cloudflare-worker/retell-token-worker.js
NEXT_PUBLIC_RETELL_TOKEN_URL=https://retell-token-worker.m-mehlab17.workers.dev/

# Optional: label shown in transcript for the agent (default Sara).
NEXT_PUBLIC_RETELL_AGENT_NAME=Sara
